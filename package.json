{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "start": "node dist-server/server.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/project_persistence.test.ts",
    "test:snap": "node ./node_modules/tsx/dist/cli.mjs tests/smart_snapping.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/snap_references.test.ts",
    "test:step": "python tests/step_export.test.py"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "draco3d": "^1.5.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "martinez-polygon-clipping": "^0.8.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "occt-import-js": "^0.0.23",
    "polygon-clipping": "^0.15.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "three-csg-ts": "^3.2.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
