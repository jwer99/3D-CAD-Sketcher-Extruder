# Puerto en el que escuchará el servidor de producción (por defecto 3000 o el asignado por el hosting)
PORT=3000

# Clave API opcional para el servicio de Reconstrucción Asistida por IA (Gemini)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Entorno
NODE_ENV=production

# Datos PUBLICOS de monetización. Se leen en el servidor; no necesitan recompilar el cliente.
# Correo comercial para recibir consultas de modelado CAD.
SALES_EMAIL=juandedofeliz@gmail.com
# Enlace HTTPS de aportación creado por el titular en Stripe Payment Links,
# PayPal, Ko-fi o Buy Me a Coffee. Nunca pegues claves secretas aquí.
SUPPORT_PAYMENT_URL=https://www.paypal.me/jwer99
